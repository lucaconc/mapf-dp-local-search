+// Load an initial solution written in the format of writePathsToFile:
+// first line the number of agents, then one line per agent with the
+// comma-separated locations of its path (until its arrival at the goal).
+bool LNS::loadInitialPaths()
+{
+    std::ifstream in(init_paths_file);
+    if (!in.is_open())
+    {
+        cerr << "Cannot open initial paths file " << init_paths_file << endl;
+        return false;
+    }
+    int n;
+    string line;
+    getline(in, line);
+    n = std::stoi(line);
+    if (n != (int)agents.size())
+    {
+        cerr << "Initial paths file has " << n << " agents, expected " << agents.size() << endl;
+        exit(-1);
+    }
+    neighbor.sum_of_costs = 0;
+    for (int i = 0; i < n; i++)
+    {
+        getline(in, line);
+        agents[i].path.clear();
+        std::stringstream ss(line);
+        string tok;
+        while (getline(ss, tok, ','))
+            if (!tok.empty())
+                agents[i].path.emplace_back(std::stoi(tok));
+        if (agents[i].path.empty() ||
+            agents[i].path.front().location != agents[i].path_planner.start_location ||
+            agents[i].path.back().location != agents[i].path_planner.goal_location)
+        {
+            cerr << "Initial path of agent " << i << " does not connect its start and goal" << endl;
+            exit(-1);
+        }
+        path_table.insertPath(agents[i].id, agents[i].path);
+        neighbor.sum_of_costs += (int)agents[i].path.size() - 1;
+    }
+    return true;
+}
